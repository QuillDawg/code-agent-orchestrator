# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.ps1]
# PowerShell tooling on Windows still defaults to CRLF.
end_of_line = crlf

[Makefile]
indent_style = tab
