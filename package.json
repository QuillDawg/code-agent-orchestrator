{
  "name": "code-agent-orchestrator",
  "version": "2.0.0-beta.2",
  "description": "Run YAML-defined engineering workflows as a DAG of isolated Claude Code and Codex sessions",
  "type": "module",
  "license": "MIT",
  "author": "Luxaviation Development (https://github.com/Luxaviation-Development)",
  "homepage": "https://github.com/QuillDawg/code-agent-orchestrator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuillDawg/code-agent-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/QuillDawg/code-agent-orchestrator/issues"
  },
  "keywords": [
    "orchestrator",
    "workflow",
    "dag",
    "agent",
    "ai-agent",
    "claude",
    "claude-code",
    "codex",
    "cli",
    "automation",
    "yaml",
    "git-worktree"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "code-agent-orchestrator": "dist/bin.js",
    "cao": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md",
    "!docs/cao-v2-beta-spec.md",
    "!docs/cao-v2-beta-decisions.md",
    "examples"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "npm run build:protocol && tsup",
    "build:protocol": "tsc -p packages/protocol/tsconfig.json",
    "dev": "tsx src/bin.ts",
    "typecheck": "npm run build:protocol && tsc --noEmit",
    "test": "npm run build:protocol && vitest run",
    "test:watch": "npm run build:protocol && vitest",
    "test:agents": "npm run build:protocol && vitest run --config vitest.agents.config.ts",
    "smoke:pack": "npm run build && node scripts/smoke-packaged.mjs",
    "lint": "npm run build:protocol && eslint src test packages scripts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "code-agent-orchestrator-protocol": "^0.3.0",
    "commander": "^15.0.0",
    "execa": "^9.5.2",
    "fuzzysort": "^4.0.2",
    "ink": "^7.1.1",
    "picomatch": "^4.0.2",
    "react": "^19.3.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/picomatch": "^3.0.1",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
